# Environment Configuration for Resume Interview AI

# AI Providers (Optional: Gemini API / OpenAI API. If empty, the explainable deterministic grounding engine operates automatically)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# MongoDB Database Configuration (Optional: If MongoDB is not running, falls back automatically to persistent JSON DB)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=resume_interview_ai

# Server Configuration
PORT=8000
HOST=0.0.0.0
JWT_SECRET=supersecret-jwt-key-for-demo-purposes-12345
